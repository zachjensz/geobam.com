{
  "name": "geobam.com",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run verify:deploy",
    "test": "vitest run",
    "data:slim": "node scripts/slim-countries.mjs",
    "preview": "vite preview",
    "verify:deploy": "node scripts/verify-deploy-config.mjs",
    "deploy:clean": "node scripts/clean-wrangler-redirect.mjs",
    "deploy": "npm run build && npm run deploy:clean && npm run verify:deploy && wrangler deploy",
    "deploy:check": "npm run build && npm run deploy:clean && npm run verify:deploy && wrangler deploy --dry-run"
  },
  "dependencies": {
    "preact": "^11.0.1",
    "three": "^0.186.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.5",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "@types/topojson-client": "^3.1.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.10",
    "world-countries": "^5.1.0",
    "wrangler": "^4.151.3"
  }
}
